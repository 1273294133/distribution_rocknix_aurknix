# Adapted for ROCKNIX S905 chain-boot (CoreELEC Amlogic-no compatible)

# ramdisk MUST be uncompressed cpio for old GXL-era stock U-Boot (EE 4.3
# verified bootable): gzip ramdisk still fails bootm on 2017 Amlogic U-Boot
# -> black screen reboot loop. Use the raw .cpio exactly like EmuELEC 4.3.
INITRAMFS="${1}.cpio"
RAMDISK=${BUILD}/image/${INITRAMFS}

echo
echo "Using uncompressed cpio ramdisk (EE 4.3 aligned)"
stat -c "  %s bytes  %n" ${RAMDISK}

LDFLAGS="" mkbootimg --kernel arch/${TARGET_KERNEL_ARCH}/boot/${KERNEL_TARGET} --ramdisk ${RAMDISK} \
  ${ANDROID_BOOTIMG_OPTIONS} --output arch/${TARGET_KERNEL_ARCH}/boot/boot.img
