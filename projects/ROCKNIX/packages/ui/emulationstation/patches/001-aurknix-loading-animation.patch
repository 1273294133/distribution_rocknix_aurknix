+// AURKNIX: load a PNG frame sequence (loading_0.png, loading_1.png, ...) next to
+// the GIF. TextureResource-based, so it uses the same working image pipeline as
+// the UI itself — far more reliable than runtime FreeImage GIF decoding.
+bool Splash::loadPngSequence(const std::string& gifPath)
+{
+	std::string dir = Utils::FileSystem::getParent(gifPath);
+	if (dir.empty())
+		dir = "/usr/config/emulationstation";
+
+	FILE* giflog = fopen("/tmp/es_gif.log", "a");
+	if (giflog) fprintf(giflog, "loadPngSequence: %s\n", dir.c_str());
+
+	for (int i = 0; ; i++)
+	{
+		std::string png = dir + "/loading_" + std::to_string(i) + ".png";
+		if (!Utils::FileSystem::exists(png))
+		{
+			if (i == 0)
+			{
+				if (giflog) { fprintf(giflog, "  no loading_0.png, fall back to GIF\n"); fclose(giflog); }
+				return false;
+			}
+			break;
+		}
+
+		auto tex = TextureResource::get(png, true, false, true, false, false);
+		if (tex != nullptr && tex->isLoaded())
+		{
+			mPngTextures.push_back(tex);
+			if (giflog) fprintf(giflog, "  frame %d OK\n", i);
+		}
+		else if (giflog)
+			fprintf(giflog, "  frame %d FAILED to load\n", i);
+	}
+
+	if (mPngTextures.empty())
+	{
+		if (giflog) { fprintf(giflog, "  no frames loaded\n"); fclose(giflog); }
+		return false;
+	}
+
+	mAnimCount = (int)mPngTextures.size();
+	mAnimCurrent = 0;
+	mAnimStartTick = SDL_GetTicks();
+	mAnimFrameMs = 600; // 5 frames @ 600 ms/frame (~3 s loop)
+	if (giflog) { fprintf(giflog, "  OK, %d png frames\n", mAnimCount); fclose(giflog); }
+	return true;
+}
+
+// AURKNIX: load an animated GIF into per-frame GL textures. FreeImage 32-bit
+// pixels are stored BGRA in memory, the renderer expects RGBA.
+bool Splash::loadGifAnimation(const std::string& path)
+{
+	FILE* giflog = fopen("/tmp/es_gif.log", "a");
+	if (giflog) fprintf(giflog, "loadGifAnimation: %s\n", path.c_str());
+
+	FreeImage_Initialise(); // safe to call multiple times
+
+	FIMULTIBITMAP* mb = FreeImage_OpenMultiBitmap(FIF_GIF, path.c_str(), true, false, GIF_PLAYBACK);
+	if (mb == nullptr)
+	{
+		if (giflog) { fprintf(giflog, "  OpenMultiBitmap FAILED\n"); fclose(giflog); }
+		return false;
+	}
+
+	int pages = FreeImage_GetPageCount(mb);
+	if (giflog) fprintf(giflog, "  pages=%d\n", pages);
+	if (pages <= 0)
+	{
+		FreeImage_CloseMultiBitmap(mb, 0);
+		if (giflog) { fprintf(giflog, "  no pages\n"); fclose(giflog); }
+		return false;
+	}
+
+	bool first = true;
+	for (int i = 0; i < pages; i++)
+	{
+		FIBITMAP* page = FreeImage_LockPage(mb, i);
+		if (page == nullptr)
+			continue;
+
+		FIBITMAP* conv = FreeImage_ConvertTo32Bits(page);
+		if (conv != nullptr)
+		{
+			unsigned int w = FreeImage_GetWidth(conv);
+			unsigned int h = FreeImage_GetHeight(conv);
+			if (first)
+			{
+				mAnimW = w;
+				mAnimH = h;
+				first = false;
+			}
+			BYTE* bits = FreeImage_GetBits(conv);
+
+			std::vector<unsigned char> rgba(w * h * 4);
+			for (unsigned int k = 0; k < w * h; k++)
+			{
+				rgba[k * 4 + 0] = bits[k * 4 + FI_RGBA_RED];
+				rgba[k * 4 + 1] = bits[k * 4 + FI_RGBA_GREEN];
+				rgba[k * 4 + 2] = bits[k * 4 + FI_RGBA_BLUE];
+				rgba[k * 4 + 3] = bits[k * 4 + FI_RGBA_ALPHA];
+			}
+
+			unsigned int tid = Renderer::createTexture(Renderer::Texture::RGBA, true, false, w, h, rgba.data());
+			if (tid != 0)
+				mAnimTextures.push_back(tid);
+
+			FreeImage_Unload(conv);
+		}
+		FreeImage_UnlockPage(mb, page, false);
+	}
+	FreeImage_CloseMultiBitmap(mb, 0);
+
+	if (mAnimTextures.empty())
+	{
+		if (giflog) { fprintf(giflog, "  no textures created\n"); fclose(giflog); }
+		return false;
+	}
+
+	mAnimCount = (int)mAnimTextures.size();
+	mAnimCurrent = 0;
+	mAnimStartTick = SDL_GetTicks();
+	mAnimFrameMs = 600; // AURKNIX loading animation is 5 frames @ 600 ms/frame (~3 s loop)
+	if (giflog) { fprintf(giflog, "  OK, %d gif textures\n", mAnimCount); fclose(giflog); }
+	return true;
+}
 
