 	Renderer::setMatrix(trans);
 	Renderer::drawRect(0, 0, Renderer::getScreenWidth(), Renderer::getScreenHeight(), (mBackgroundColor & 0xFFFFFF00) | alpha);
 
+	// AURKNIX: animated GIF mode — draw the current frame (4:3, centered) and
+	// skip the static background / progress UI.
+	if (mAnimated && (!mPngTextures.empty() || !mAnimTextures.empty()))
+	{
+		unsigned int now = SDL_GetTicks();
+		if (mAnimStartTick == 0)
+			mAnimStartTick = now;
+		int frame = (int)((now - mAnimStartTick) / mAnimFrameMs);
+		mAnimCurrent = frame % mAnimCount;
+
+		if (!mPngTextures.empty())
+			mPngTextures[mAnimCurrent]->bind();
+		else
+			Renderer::bindTexture(mAnimTextures[mAnimCurrent]);
+
+		float sw = (float)Renderer::getScreenWidth();
+		float sh = (float)Renderer::getScreenHeight();
+		float vw, vh;
+		if (sw / sh > 4.0f / 3.0f)
+		{
+			vh = sh;
+			vw = sh * 4.0f / 3.0f;
+		}
+		else
+		{
+			vw = sw;
+			vh = sw * 3.0f / 4.0f;
+		}
+		float ox = (sw - vw) / 2.0f;
+		float oy = (sh - vh) / 2.0f;
+
+		unsigned int col = 0xFFFFFF00 | alpha;
+		Renderer::Vertex vertices[4];
+		vertices[0] = Renderer::Vertex(Vector2f(ox, oy), Vector2f(0, 0), col);
+		vertices[1] = Renderer::Vertex(Vector2f(ox + vw, oy), Vector2f(1, 0), col);
+		vertices[2] = Renderer::Vertex(Vector2f(ox + vw, oy + vh), Vector2f(1, 1), col);
+		vertices[3] = Renderer::Vertex(Vector2f(ox, oy + vh), Vector2f(0, 1), col);
+
+		Renderer::drawTriangleStrips(vertices, 4);
+
+		if (swapBuffers)
+		{
+			Renderer::swapBuffers();
+
+#if defined(_WIN32)
+			SDL_Event event;
+			while (SDL_PollEvent(&event));
+#endif
+		}
+		return;
+	}
+
 	for (auto extra : mExtras)
 		extra->setOpacity(alpha);
 
