+// AURKNIX: load an animated GIF into per-frame GL textures. FreeImage 32-bit
+// pixels are stored BGRA in memory, the renderer expects RGBA.
+bool Splash::loadGifAnimation(const std::string& path)
+{
+	FIMULTIBITMAP* mb = FreeImage_OpenMultiBitmap(FIF_GIF, path.c_str(), true, false, GIF_PLAYBACK);
+	if (mb == nullptr)
+		return false;
+
+	int pages = FreeImage_GetPageCount(mb);
+	if (pages <= 0)
+	{
+		FreeImage_CloseMultiBitmap(mb, 0);
+		return false;
+	}
+
+	bool first = true;
+	for (int i = 0; i < pages; i++)
+	{
+		FIBITMAP* page = FreeImage_LockPage(mb, i);
+		if (page == nullptr)
+			continue;
+
+		FIBITMAP* conv = FreeImage_ConvertTo32Bits(page);
+		if (conv != nullptr)
+		{
+			unsigned int w = FreeImage_GetWidth(conv);
+			unsigned int h = FreeImage_GetHeight(conv);
+			if (first)
+			{
+				mAnimW = w;
+				mAnimH = h;
+				first = false;
+			}
+			BYTE* bits = FreeImage_GetBits(conv);
+
+			std::vector<unsigned char> rgba(w * h * 4);
+			for (unsigned int k = 0; k < w * h; k++)
+			{
+				rgba[k * 4 + 0] = bits[k * 4 + FI_RGBA_RED];
+				rgba[k * 4 + 1] = bits[k * 4 + FI_RGBA_GREEN];
+				rgba[k * 4 + 2] = bits[k * 4 + FI_RGBA_BLUE];
+				rgba[k * 4 + 3] = bits[k * 4 + FI_RGBA_ALPHA];
+			}
+
+			unsigned int tid = Renderer::createTexture(Texture::RGBA, true, false, w, h, rgba.data());
+			if (tid != 0)
+				mAnimTextures.push_back(tid);
+
+			FreeImage_Unload(conv);
+		}
+		FreeImage_UnlockPage(mb, page, false);
+	}
+	FreeImage_CloseMultiBitmap(mb, 0);
+
+	if (mAnimTextures.empty())
+		return false;
+
+	mAnimCount = (int)mAnimTextures.size();
+	mAnimCurrent = 0;
+	mAnimStartTick = SDL_GetTicks();
+	mAnimFrameMs = 57; // AURKNIX loading animation is 49 frames @ 57 ms/frame (~2.8 s loop)
+	return true;
+}
 
